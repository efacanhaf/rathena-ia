
COMMON_H = $(shell ls ../common/*.hpp)
COMMON_AR = ../common/obj/common.a
COMMON_INCLUDE = -I../common/

RA_INCLUDE = -I../

LIBCONFIG_H = $(shell ls ../../3rdparty/libconfig/*.h)
LIBCONFIG_AR = ../../3rdparty/libconfig/obj/libconfig.a
LIBCONFIG_INCLUDE = -I../../3rdparty/libconfig

AI_OBJ = $(shell ls *.cpp | sed -e "s/\.cpp/\.o/g")
AI_DIR_OBJ = $(AI_OBJ:%=obj/%)
AI_H = $(shell ls *.hpp)


SERVER_DEPENDS=ai-server

HAVE_MYSQL=@HAVE_MYSQL@
ifeq ($(HAVE_MYSQL),yes)
	SERVER_DEPENDS=ai-server
else
	SERVER_DEPENDS=needs_mysql
endif

ALL_DEPENDS=server

@SET_MAKE@

#####################################################################
.PHONY: all server clean help

all: $(ALL_DEPENDS)

server: $(SERVER_DEPENDS)

clean:
	@echo "	CLEAN	ai"
	@rm -rf *.o obj ../../@OAI@@EXEEXT@

help:
	@echo "possible targets are 'server' 'all' 'clean' 'help'"
	@echo "'server'    - ai server"
	@echo "'all'       - builds all above targets"
	@echo "'clean'     - cleans builds and objects"
	@echo "'help'      - outputs this message"

#####################################################################

needs_mysql:
	@echo "MySQL not found or disabled by the configure script"
	@exit 1

# object directories

obj:
	@echo "	MKDIR	obj"
	@-mkdir obj

#executables

ai-server: obj $(AI_DIR_OBJ) $(COMMON_AR) $(LIBCONFIG_AR)
	@echo "	LD	@OAI@@EXEEXT@"
	@@CXX@ @LDFLAGS@ -o ../../@OAI@@EXEEXT@ $(AI_DIR_OBJ) $(COMMON_AR) $(LIBCONFIG_AR) @LIBS@ @MYSQL_LIBS@

# ai object files

obj/%.o: %.cpp $(AI_H) $(COMMON_H) $(LIBCONFIG_H)
	@echo "	CXX	$<"
	@@CXX@ @CXXFLAGS@ $(COMMON_INCLUDE) $(RA_INCLUDE) $(LIBCONFIG_INCLUDE) @MYSQL_CFLAGS@ @CPPFLAGS@ -c $(OUTPUT_OPTION) $<

# missing object files
$(COMMON_AR):
	@$(MAKE) -C ../common server

$(LIBCONFIG_AR):
	@$(MAKE) -C ../../3rdparty/libconfig
